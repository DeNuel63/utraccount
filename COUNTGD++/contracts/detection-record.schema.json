{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utraccount.local/contracts/detection-record/v1",
  "title": "U-TracCount Detection Batch v1",
  "description": "Tracker-ready CountGD++ detections for exactly one video frame.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence_id",
    "frame_index",
    "frame",
    "source",
    "detections"
  ],
  "properties": {
    "schema_version": {"const": "utraccount.detection-batch/v1"},
    "sequence_id": {"type": "string", "minLength": 1},
    "frame_index": {"type": "integer", "minimum": 0},
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "width_px", "height_px"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "width_px": {"type": "integer", "exclusiveMinimum": 0},
        "height_px": {"type": "integer", "exclusiveMinimum": 0},
        "timestamp_ms": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_name", "model_version", "prompt", "confidence_threshold", "box_format", "coordinate_space"],
      "properties": {
        "model_name": {"const": "CountGD++"},
        "model_version": {"type": "string", "minLength": 1},
        "prompt": {"type": "string"},
        "confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "box_format": {"const": "xywh_center"},
        "coordinate_space": {"const": "pixel"},
        "raw_output_uri": {"type": ["string", "null"]}
      }
    },
    "detections": {
      "type": "array",
      "items": {"$ref": "#/$defs/detection"}
    }
  },
  "$defs": {
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection_id", "bbox_xywh_center", "label", "confidence"],
      "properties": {
        "detection_id": {"type": "string", "minLength": 1},
        "bbox_xywh_center": {
          "type": "array",
          "description": "[centre_x_px, centre_y_px, width_px, height_px] in original-frame pixels.",
          "items": {"type": "number"},
          "minItems": 4,
          "maxItems": 4
        },
        "label": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "ground_truth_instance_id": {"type": ["string", "null"]}
      }
    }
  }
}
